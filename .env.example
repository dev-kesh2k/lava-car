# Projeto Supabase (Settings → API). A anon key é pública por natureza; a segurança vem do RLS.
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Chave pública VAPID do Web Push (a privada fica só nos secrets das Edge Functions).
VITE_VAPID_PUBLIC_KEY=
# Loja padrão quando o cliente entra pelo link sem ?loja= (slug do tenant).
VITE_DEFAULT_TENANT_SLUG=lava-car-demo
